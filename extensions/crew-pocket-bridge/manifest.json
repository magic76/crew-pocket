{
  "manifest_version": 3,
  "name": "Crew Pocket AI Bridge",
  "version": "1.1.0",
  "description": "Bridges Lemur Browser pages with Crew Pocket AI in Termux for remote debugging, DOM inspection & API network tracking.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crew Pocket AI Bridge"
  }
}
